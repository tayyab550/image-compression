    <script>
        // DOM Elements
        const fileInput = document.getElementById('fileInput');
        const uploadArea = document.getElementById('uploadArea');
        const browseBtn = document.getElementById('browseBtn');
        const qualitySlider = document.getElementById('qualitySlider');
        const widthSlider = document.getElementById('widthSlider');
        const qualityValue = document.getElementById('qualityValue');
        const widthValue = document.getElementById('widthValue');
        const compressBtn = document.getElementById('compressBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const resetBtn = document.getElementById('resetBtn');
        const originalPreview = document.getElementById('originalPreview');
        const compressedPreview = document.getElementById('compressedPreview');
        const originalSize = document.getElementById('originalSize');
        const compressedSize = document.getElementById('compressedSize');
        const originalDimensions = document.getElementById('originalDimensions');
        const compressedDimensions = document.getElementById('compressedDimensions');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const compressionStats = document.getElementById('compressionStats');
        const savingsPercentage = document.getElementById('savingsPercentage');
        const originalSizeStat = document.getElementById('originalSizeStat');
        const compressedSizeStat = document.getElementById('compressedSizeStat');
        const qualityStat = document.getElementById('qualityStat');

        // State variables
        let originalImage = null;
        let compressedImageBlob = null;
        let originalImageSize = 0;
        let originalImageWidth = 0;
        let originalImageHeight = 0;

        // Event Listeners
        browseBtn.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('click', () => fileInput.click());
        
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = '#4b6cb7';
            uploadArea.style.backgroundColor = '#f0f7ff';
        });
        
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = '#bdc3c7';
            uploadArea.style.backgroundColor = '';
        });
        
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = '#bdc3c7';
            uploadArea.style.backgroundColor = '';
            
            if (e.dataTransfer.files.length) {
                handleImageUpload(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) {
                handleImageUpload(e.target.files[0]);
            }
        });

        qualitySlider.addEventListener('input', () => {
            const value = qualitySlider.value;
            qualityValue.textContent = `${value}%`;
        });

        widthSlider.addEventListener('input', () => {
            const value = widthSlider.value;
            widthValue.textContent = value === "2000" ? "Original" : `${value}px`;
        });

        compressBtn.addEventListener('click', compressImage);
        downloadBtn.addEventListener('click', downloadCompressedImage);
        resetBtn.addEventListener('click', resetTool);

        // Initialize with example image
        window.addEventListener('DOMContentLoaded', () => {
            // Set initial values for example image
            originalImageSize = 1.2;
            originalImageWidth = 1200;
            originalImageHeight = 800;
            
            originalSize.textContent = `${originalImageSize} MB`;
            originalDimensions.textContent = `${originalImageWidth}x${originalImageHeight}`;
            
            // Set compressed image stats for example
            compressedSize.textContent = `0.6 MB`;
            compressedDimensions.textContent = `1000x667`;
        });

        // Functions
        function handleImageUpload(file) {
            if (!file.type.match('image.*')) {
                alert('Please select an image file (JPEG, PNG, or WebP)');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                originalImage = new Image();
                originalImage.onload = () => {
                    // Update preview
                    originalPreview.src = e.target.result;
                    
                    // Calculate and display original image size
                    originalImageSize = (file.size / (1024 * 1024)).toFixed(2);
                    originalSize.textContent = `${originalImageSize} MB`;
                    
                    // Store original dimensions
                    originalImageWidth = originalImage.width;
                    originalImageHeight = originalImage.height;
                    originalDimensions.textContent = `${originalImageWidth}x${originalImageHeight}`;
                    
                    // Reset compressed preview
                    compressedPreview.src = 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=50';
                    compressedSize.textContent = `0 MB`;
                    compressedDimensions.textContent = `0x0`;
                    
                    // Reset download button
                    downloadBtn.disabled = true;
                    
                    // Hide compression stats
                    compressionStats.style.display = 'none';
                    
                    // Update width slider max value
                    widthSlider.max = Math.min(originalImageWidth, 2000);
                    widthSlider.value = Math.min(originalImageWidth, 1000);
                    widthValue.textContent = widthSlider.value === "2000" ? "Original" : `${widthSlider.value}px`;
                };
                originalImage.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function compressImage() {
            if (!originalImage) {
                alert('Please upload an image first');
                return;
            }

            // Show loading indicator
            loadingIndicator.style.display = 'block';
            compressionStats.style.display = 'none';
            
            // Simulate compression process (in a real app, this would use actual compression)
            setTimeout(() => {
                // Get compression settings
                const quality = parseInt(qualitySlider.value) / 100;
                const targetWidth = parseInt(widthSlider.value);
                
                // Calculate compressed dimensions
                const aspectRatio = originalImageHeight / originalImageWidth;
                const newWidth = targetWidth === 2000 ? originalImageWidth : targetWidth;
                const newHeight = Math.round(newWidth * aspectRatio);
                
                // Update compressed preview
                compressedPreview.src = originalPreview.src; // In a real app, this would be the compressed image
                
                // Simulate compressed file size
                const compressedSizeValue = (originalImageSize * quality * (newWidth / originalImageWidth)).toFixed(2);
                compressedSize.textContent = `${compressedSizeValue} MB`;
                compressedDimensions.textContent = `${newWidth}x${newHeight}`;
                
                // Create a fake blob for download simulation
                compressedImageBlob = new Blob(['compressed image data'], {type: 'image/jpeg'});
                
                // Calculate savings
                const savings = ((originalImageSize - compressedSizeValue) / originalImageSize * 100).toFixed(0);
                
                // Update compression stats
                savingsPercentage.textContent = `${savings}%`;
                originalSizeStat.textContent = `${originalImageSize} MB`;
                compressedSizeStat.textContent = `${compressedSizeValue} MB`;
                qualityStat.textContent = `${qualitySlider.value}%`;
                
                // Enable download button
                downloadBtn.disabled = false;
                
                // Hide loading indicator
                loadingIndicator.style.display = 'none';
                
                // Show compression stats
                compressionStats.style.display = 'block';
                
                // Scroll to show results
                compressionStats.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 1500);
        }

        function downloadCompressedImage() {
            if (!compressedImageBlob) {
                alert('No compressed image available. Please compress an image first.');
                return;
            }

            // Create a download link
            const downloadLink = document.createElement('a');
            downloadLink.href = URL.createObjectURL(compressedImageBlob);
            downloadLink.download = `compressed-image-${qualitySlider.value}quality.jpg`;
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        function resetTool() {
            // Reset file input
            fileInput.value = '';
            
            // Reset previews to example
            originalPreview.src = 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80';
            compressedPreview.src = 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=50';
            
            // Reset stats
            originalSize.textContent = '1.2 MB';
            compressedSize.textContent = '0.6 MB';
            originalDimensions.textContent = '1200x800';
            compressedDimensions.textContent = '1000x667';
            
            // Reset sliders
            qualitySlider.value = 85;
            qualityValue.textContent = '85%';
            widthSlider.value = 1000;
            widthSlider.max = 2000;
            widthValue.textContent = 'Original';
            
            // Reset state
            originalImage = null;
            compressedImageBlob = null;
            originalImageSize = 1.2;
            originalImageWidth = 1200;
            originalImageHeight = 800;
            
            // Disable download button
            downloadBtn.disabled = true;
            
            // Hide compression stats
            compressionStats.style.display = 'none';
        }
    </script>
</body>
</html>
